# Copy to .env at the repo root. Never commit .env.

# Claude (coordinator only)
ANTHROPIC_API_KEY=

# Fetch.ai Agentverse (mailbox for ASI:One). Set AGENT_MAILBOX=true to connect.
AGENTVERSE_API_KEY=
AGENT_MAILBOX=false

# SpacetimeDB (local server from `spacetime start`)
SPACETIMEDB_URL=ws://localhost:3000
SPACETIMEDB_DB=recallzero

# Gateway
GATEWAY_URL=http://localhost:4000
GATEWAY_PORT=4000
GATEWAY_MODE=mock            # mock | spacetimedb

# Retailer agent instance: STORE-A or STORE-B
STORE_ID=STORE-A

# Web app: Next.js reads web/.env.local (not this file) and only exposes NEXT_PUBLIC_* to the browser.
# spacetimedb = live subscriptions for reads; every write goes through the gateway.
NEXT_PUBLIC_DATA_SOURCE=mock # mock | spacetimedb
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4000
NEXT_PUBLIC_SPACETIMEDB_URL=ws://localhost:3000
NEXT_PUBLIC_SPACETIMEDB_DB=recallzero
